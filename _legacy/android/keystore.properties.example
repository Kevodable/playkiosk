# TEMPLATE — copia questo file in:  android/keystore.properties
# (quello vero è gitignorato: NON va mai committato, contiene le password)
#
# Poi metti il file della keystore in:  android/app/release.keystore
# e builda con:  ./gradlew :app:assembleRelease
#
# Se questo file non esiste, la build di release ricade automaticamente sulla
# firma di debug (utile per test nel container/CI senza segreti).

storeFile=release.keystore
storePassword=METTI_LA_PASSWORD
keyAlias=bigbenmatic
keyPassword=METTI_LA_PASSWORD
